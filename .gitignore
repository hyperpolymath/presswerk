# RSR-compliant .gitignore
# SPDX-License-Identifier: PMPL-1.0-or-later
# Presswerk .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.directory

# Build
/target/
/dist/
/out/

# Rust
# Keep Cargo.lock for binary crate

# Dioxus
/gen/
/.dioxus/

# Dependencies
/node_modules/
/vendor/

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak

# Crash recovery artifacts
ai-cli-crash-capture/

# Sync artifacts
sync_report*.txt


# Cargo.lock  # Keep for binaries


# Elixir
/cover/
/doc/
*.ez
erl_crash.dump


# Julia
*.jl.cov
*.jl.mem
/Manifest.toml


# ReScript
/lib/bs/
/.bsb.lock


# Python (SaltStack only)
__pycache__/
*.py[cod]
.venv/


# Ada/SPARK
*.ali
/obj/
/bin/


# Haskell
/.stack-work/
/dist-newstyle/


# Chapel
*.chpl.tmp.*


# Machine-readable locks
.machine_readable/.locks/
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
build/
dist/
